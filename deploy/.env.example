# cmpose-app settings. On the server this file becomes apps/cmpose-app.env (git-ignored there); keep a copy in your
# password manager. Placeholders only: never commit real values.

# --- Required ---
DATABASE_URL=jdbc:postgresql://postgres:5432/cmpose_app
DATABASE_USER=cmpose_app
# The password given to deploy/sql/create-cmpose-app.sql.
DATABASE_PASSWORD=change-me
# Firebase console -> Project settings -> Project ID. Not a secret, but server specific.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Set by the compose file to the files volume; only needed when running the jar elsewhere.
FILES_DIR=/data/files

# --- Optional (defaults shown) ---
PORT=8080
# Comma-separated browser origins, e.g. https://app.example.com. Empty: CORS off (mobile clients need none).
CORS_ALLOWED_ORIGINS=
# Proxies whose X-Forwarded-For is believed (CIDRs). The default is Docker's private range.
TRUSTED_PROXIES=172.16.0.0/12
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SENSITIVE_PER_MINUTE=10
MAX_JSON_BYTES=1048576
# Keep nginx's client_max_body_size a little above this.
MAX_UPLOAD_BYTES=10485760
# Uploads held in memory at once; one more is refused with 503 UPLOADS_BUSY and Retry-After.
MAX_CONCURRENT_UPLOADS=4
# Clients below this X-Client-Version get 426. Empty: no check.
MIN_CLIENT_VERSION=
# Quotas: a write past one is refused with 409 QUOTA_EXCEEDED. 0 turns the quota off.
# Total bytes of the files counted against a user.
MAX_STORAGE_BYTES_PER_USER=104857600
# cmpose:sharing
INVITE_TTL_DAYS=7
# Spaces a user owns besides the personal one; members of a space, owner included; valid invites of a space.
MAX_SPACES_PER_USER=20
MAX_MEMBERS_PER_SPACE=50
MAX_PENDING_INVITES_PER_SPACE=20
# /cmpose:sharing
# The public URL of the API, e.g. https://api.example.com/cmpose-app (used in the OpenAPI document).
PUBLIC_BASE_URL=
JWT_CLOCK_SKEW_SECONDS=60
DB_POOL_SIZE=5
JAVA_OPTS=-XX:MaxRAMPercentage=75
# Baked into the image at build time; leave unset here.
# APP_VERSION=dev

# --- Server repository's top-level .env (compose interpolation, not read by the app) ---
# IMAGE_OWNER=your-github-owner
# IMAGE_TAG=latest
# CMPOSE_APP_MEM_LIMIT=512m
